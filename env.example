# ─────────────────────────────────────────────────────────────
# Copy this file to .env for local use, OR set these as
# Environment Variables in the Render dashboard for deployment.
# NEVER commit a real .env file to GitHub.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=10000
# The public URL of your deployed app (no trailing slash).
# On Render this is something like https://your-app.onrender.com
APP_URL=http://localhost:10000
# A long random string used to sign login sessions. Generate any
# random 40+ character string.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Neon Postgres ──
# Copy the "connection string" from your Neon dashboard.
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── AI model provider (OpenAI-compatible) ──
# Works with OpenAI, OpenRouter, Together, Groq, etc.
# Default base URL is OpenAI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key-here
# Comma-separated list of models to show in the model picker.
AI_MODELS=gpt-4o-mini,gpt-4o
# Default model (must be one of AI_MODELS)
AI_DEFAULT_MODEL=gpt-4o-mini

# ── Google OAuth ──
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Stripe ──
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Create two recurring Prices in Stripe, paste their IDs here.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MAX=price_...
# From the webhook endpoint you create in Stripe (see README).
STRIPE_WEBHOOK_SECRET=whsec_...
