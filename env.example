# Copy each of these into Replit → Tools → Secrets (don't paste real values into this file).

# --- Google sign-in ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Claude (Anthropic) ---
# From https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Stripe ---
# From https://dashboard.stripe.com (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# After you create the webhook endpoint in Stripe (see README), paste its signing secret:
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional: if you'd rather create the prices yourself, paste their IDs.
# Leave blank and the app creates them automatically on first checkout.
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# --- Session signing ---
# Any long random string. Keeps users signed in across restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional: extra comp accounts (comma-separated emails that get MAX free) ---
# rishi.parikh17@gmail.com is already built in.
COMP_MAX_EMAILS=
